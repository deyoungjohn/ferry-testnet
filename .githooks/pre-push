#!/usr/bin/env bash
# Refuse to push when the cheap repo-wide checks fail.
# Bypass only deliberately: git push --no-verify
set -u
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1
for check in format:check typecheck lint; do
  if ! pnpm --silent "$check" >/tmp/ferry-prepush-"$check".log 2>&1; then
    echo "pre-push: 'pnpm $check' failed; see /tmp/ferry-prepush-$check.log" >&2
    tail -n 15 /tmp/ferry-prepush-"$check".log >&2
    exit 1
  fi
done

# Repository hygiene & credential audit
if ! pnpm --silent --filter @ferry/scripts hygiene >/tmp/ferry-prepush-hygiene.log 2>&1; then
  echo "pre-push: repository hygiene check failed; see /tmp/ferry-prepush-hygiene.log" >&2
  cat /tmp/ferry-prepush-hygiene.log >&2
  exit 1
fi

exit 0
