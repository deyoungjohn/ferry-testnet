{
  "name": "ferry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Ferry: trust-minimised stablecoin swaps between Bitcoin Cash and other chains.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm lint:root && pnpm -r --if-present lint",
    "lint:root": "eslint *.mjs *.ts eslint-rules test",
    "test:unit": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "toolchain:check": "bash scripts/toolchain/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
