# --- network selection ---
NETWORK=testnet
ENABLED_ROUTES=usdc:base

# --- mainnet network fields (unverified values stay empty) ---
# L4 verifies mainnet BCH endpoints before L9 use.
BCH_ELECTRUM_URLS=
# L9 verifies the mainnet RPC/provider and deployed HTLC.
BASE_RPC_URL=
# Source: https://docs.base.org/get-started/connect-to-base
BASE_CHAIN_ID=8453
FERRY_HTLC_ADDRESS=
# Source: https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# L2 verifies PUSD/MUSD categories and Paryon endpoint before L9 use.
PUSD_CATEGORY=
MUSD_CATEGORY=
PARYON_STATS_URL=

# --- testnet only: chipnet + Base Sepolia ---
# L0/L2: verify a working chipnet Fulcrum endpoint.
BCH_CHIPNET_ELECTRUM_URLS=wss://chipnet.imaginary.cash:50004
# Source: https://docs.base.org/get-started/connect-to-base
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
# Source: https://developers.circle.com/stablecoins/usdc-contract-addresses
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# L3 verifies the deployed Base Sepolia HTLC.
BASE_SEPOLIA_FERRY_HTLC_ADDRESS=0x5A0C062f4B7b8fF2263530e12bc15De9C836a641
# L2 verifies chipnet test-token categories after minting.
TPUSD_CATEGORY=ec335fd3ffa45f80cef7217cf98e8adf562df5a3e33f354f69df2951703586ac
TMUSD_CATEGORY=c99627aec3e041f281068704c2609699d234586d5097301eff995f3bd00ac04d

# --- solver secrets (never commit values) ---
SOLVER_BCH_WIF=
SOLVER_EVM_PRIVATE_KEY=

# --- policy (blueprint §7.5; L4 validates these defaults) ---
QUOTING_ENABLED=true
SPREAD_BPS=40
FIXED_FEE_USD=0.05
MIN_SWAP_USD=1
MAX_SWAP_USD=50
MAX_OPEN_EXPOSURE_USD=250
ZERO_CONF_MAX_USD=25
QUOTE_TTL_S=60
PEG_TOLERANCE=0.01
EVM_CONFS=10
DSPROOF_WINDOW_MS=5000
FWD_BCH_REFUND_BLOCKS=36
FWD_EVM_DEADLINE_S=86400
REV_BCH_REFUND_BLOCKS=144
REV_EVM_DEADLINE_S=21600
REV_MIN_REMAINING_BLOCKS=108
BCH_CARRY_SATS=3000
BCH_MAX_FEE_SATS=1500
SKEW_MAX_BPS=50

# --- web (L5: human Reown project ID and local solver endpoint) ---
VITE_REOWN_PROJECT_ID=
VITE_SOLVER_URL=
VITE_SOLVER_SIGNING_ADDRESS=
VITE_USE_MOCKS=
