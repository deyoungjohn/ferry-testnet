{
  "name": "@ferry/chain-tron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "ferry-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --config vitest.config.ts",
    "test:nile": "RUN_NILE_TESTS=true vitest run test/nile.integration.test.ts"
  },
  "dependencies": {
    "@ferry/core": "workspace:*",
    "@ferry/htlc-tron": "workspace:*",
    "tronweb": "6.5.1",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
