{
  "name": "@ferry/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/check-spike-excluded.mjs && node scripts/build-recover.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:recover": "node scripts/build-recover.mjs",
    "check:recover": "node scripts/build-recover.mjs --check",
    "test:e2e:recover": "node scripts/build-recover.mjs && playwright test -c playwright.recover.config.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@ferry/core": "workspace:*",
    "@ferry/htlc-bch": "workspace:*",
    "@ferry/htlc-evm": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@tanstack/react-query": "5.104.5",
    "@wizardconnect/core": "0.2.5",
    "@wizardconnect/dapp": "0.2.2",
    "@wizardconnect/react": "0.2.3",
    "framer-motion": "14.6.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "vaul": "1.1.2",
    "viem": "2.57.10",
    "wagmi": "3.7.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "ws": "8.22.0"
  }
}
